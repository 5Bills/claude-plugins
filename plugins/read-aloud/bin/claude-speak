#!/usr/bin/env python3
"""Read Claude Code replies aloud with edge-tts (Microsoft neural voices, online, free).

  claude-speak hook     Stop hook: speak the last reply (hook JSON on stdin)
  claude-speak stop     silence current speech (UserPromptSubmit hook, toggle)
  claude-speak toggle   turn speaking on/off (also /read-aloud)

Needs edge-tts (pip install edge-tts) and ffplay (part of ffmpeg).
Voice and speed: CLAUDE_SPEAK_VOICE (edge-tts --list-voices), CLAUDE_SPEAK_RATE.
"""
import json, os, re, signal, subprocess, sys
from pathlib import Path

VOICE = os.environ.get("CLAUDE_SPEAK_VOICE", "en-GB-SoniaNeural")
RATE = os.environ.get("CLAUDE_SPEAK_RATE", "+10%")
STATE = Path.home() / ".local/state/claude-speak"
OFF = STATE / "off"
PIDFILE = STATE / "pid"


def stop():
    try:
        os.killpg(int(PIDFILE.read_text()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    PIDFILE.unlink(missing_ok=True)


def last_reply(hook):
    if hook.get("last_assistant_message"):
        return hook["last_assistant_message"]
    # Fall back to the transcript: text blocks since the last real user prompt.
    texts = []
    for line in Path(hook["transcript_path"]).read_text().splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        content = (e.get("message") or {}).get("content")
        if e.get("type") == "user":
            if isinstance(content, str) or any(
                    b.get("type") == "text" for b in content or []):
                texts = []
        elif e.get("type") == "assistant" and isinstance(content, list):
            texts += [b["text"] for b in content if b.get("type") == "text"]
    return texts[-1] if texts else ""


def clean(md):
    md = re.sub(r"```.*?```", " ", md, flags=re.S)             # code blocks
    md = re.sub(r"^\s*\|.*\|\s*$", " ", md, flags=re.M)        # tables
    md = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", md)         # links -> text
    md = re.sub(r"https?://\S+", " ", md)                      # bare URLs
    md = re.sub(r"`([^`]*)`", r"\1", md)                       # inline code
    md = re.sub(r"^\s*(#+|[-*+]|>)\s+", "", md, flags=re.M)    # headings, bullets, quotes
    md = re.sub(r"[*_~]{1,3}", "", md)                         # emphasis
    return re.sub(r"\s+", " ", md).strip()


def speak(text):
    STATE.mkdir(parents=True, exist_ok=True)
    stop()
    p = subprocess.Popen(
        ["sh", "-c", 'edge-tts --voice "$1" --rate="$2" --file - --write-media /dev/stdout'
                     ' | ffplay -nodisp -autoexit -loglevel quiet -i -', "sh", VOICE, RATE],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True)
    PIDFILE.write_text(str(p.pid))
    p.stdin.write(text.encode())
    p.stdin.close()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "hook":
        hook = json.load(sys.stdin)
        if OFF.exists() or hook.get("stop_hook_active"):
            return
        text = clean(last_reply(hook))
        if text:
            speak(text)
    elif cmd == "stop":
        if not sys.stdin.isatty():
            sys.stdin.read()
        stop()
    elif cmd == "toggle":
        STATE.mkdir(parents=True, exist_ok=True)
        if OFF.exists():
            OFF.unlink()
            msg = "Claude speech on"
        else:
            OFF.touch()
            stop()
            msg = "Claude speech off"
        print(msg)
        try:
            subprocess.run(["notify-send", "-a", "Claude Code", msg], check=False)
        except OSError:
            pass
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
